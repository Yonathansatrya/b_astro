                src="/NextSDS_logo.svg"
                alt="NextSDS Logo"
                class="h-6 w-auto"
            />
        </a>

        <nav
            class="hidden md:flex items-center space-x-8 text-sm font-medium text-[#081b60]"
        >
            <div class="relative group">
                <button class="flex items-center gap-1">
                    Solutions
                    <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            d="M5.23 7.21a.75.75 0 011.06.02L10 11.293l3.71-4.06a.75.75 0 111.08 1.04l-4.25 4.66a.75.75 0 01-1.08 0l-4.25-4.66a.75.75 0 01.02-1.06z"
                        ></path>
                    </svg>
                </button>
                <div
                    class="absolute left-0 mt-2 hidden group-hover:block bg-white shadow-lg rounded-md w-48 py-2 z-10"
                >
                    <a
                        href="#"
                        class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
