                    ></path>
                </svg>
            </button>
            <div class="mt-2 hidden flex-col bg-white rounded-md shadow py-2">
                <a href="#" class="block px-4 py-2 hover:bg-gray-100"
                    >Solution 1</a
                >
                <a href="#" class="block px-4 py-2 hover:bg-gray-100"
                    >Solution 2</a
                >
                <a href="#" class="block px-4 py-2 hover:bg-gray-100"
                    >Solution 3</a
                >
            </div>
        </div>

        <div class="relative">
            <button
                class="flex w-full justify-between items-center dropdown-toggle"
            >
                Industries
                <svg
                    class="w-4 h-4 transform transition-transform duration-200"
