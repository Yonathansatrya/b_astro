<header class="bg-white sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
            <img
                src="/NextSDS_logo.svg"
                alt="NextSDS Logo"
                class="h-6 w-auto"
            />
        </a>

        <nav
            class="hidden md:flex items-center space-x-8 text-sm font-medium text-[#081b60]"
        >
            <div class="relative group">
                <button class="text-[#081b60]">Solutions</button>
                <div
                    class="absolute left-0 mt-2 hidden group-hover:block bg-white shadow-lg rounded-md w-40 p-3 z-10"
                >
                    <a href="#" class="block py-1 hover:text-blue-600"
                        >Option 1</a
                    >
                    <a href="#" class="block py-1 hover:text-blue-600"
                        >Option 2</a
                    >
                </div>
            </div>

            <div class="relative group">
                <button class="text-[#081b60]">Industries</button>
                <div
                    class="absolute left-0 mt-2 hidden group-hover:block bg-white shadow-lg rounded-md w-40 p-3 z-10"
                >
                    <a href="#" class="block py-1 hover:text-blue-600"
                        >Option A</a
                    >
                    <a href="#" class="block py-1 hover:text-blue-600"
                        >Option B</a
                    >
                </div>
            </div>

            <div class="relative group">
                <button class="text-[#081b60]">Platform</button>
                <div
                    class="absolute left-0 mt-2 hidden group-hover:block bg-white shadow-lg rounded-md w-40 p-3 z-10"
                >
                    <a href="#" class="block py-1 hover:text-blue-600"
                        >Option A</a
                    >
                    <a href="#" class="block py-1 hover:text-blue-600"
                        >Option B</a
                    >
                </div>
            </div>

            <div class="relative group">
                <button class="text-[#081b60]">Tools</button>
                <div
                    class="absolute left-0 mt-2 hidden group-hover:block bg-white shadow-lg rounded-md w-40 p-3 z-10"
                >
                    <a href="#" class="block py-1 hover:text-blue-600"
                        >Option A</a
                    >
                    <a href="#" class="block py-1 hover:text-blue-600"
                        >Option B</a
                    >
                </div>
            </div>

            <a href="#" class="text-[#081b60]">Contact</a>
        </nav>

        <div class="flex items-center space-x-4 font-medium">
            <a href="/login" class="text-gray-800">Log in</a>
            <a
                href="#"
                class="inline-flex items-center gap-2 bg-[#325DF7] text-white px-4 py-2 rounded-md shadow hover:bg-[#081b60]"
            >
                Get started for free
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"
                    ></path>
                </svg>
            </a>
        </div>
    </div>
</header>
