---

<section class="mb-[80px] relative mx-2">
    <div
      class="relative z-10 text-white text-center py-10 px-6 bg-black/60 bg-blend-overlay bg-cover bg-center rounded-xl"
      style="background-image: url('/Statistic.png');"
    >
      <h3 class="text-2xl md:text-3xl font-semibold mb-8">
        Did you know an estimated (and whopping)
      </h3>
  
      <div class="flex flex-col md:flex-row justify-center items-center gap-16 mb-8">
        <div class="text-center">
          <div class="text-5xl font-bold mb-2">40%</div>
          <div class="text-base font-normal">
            of Safety Data Sheets <br /> are non-compliant.
          </div>
        </div>
  
        <div class="text-center">
          <div class="text-5xl font-bold mb-2">33%</div>
          <div class="text-base font-normal">
            of mixtures <br /> have incorrect labelling.
          </div>
        </div>
      </div>
  
      <div class="flex flex-col md:flex-row gap-4 justify-center items-center text-sm">
        <p class="flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 32 32" class="text-white">
            <path fill="currentColor" d="M22.8 12.3c.304-.308.304-.808 0-1.12s-.796-.308-1.1 0l-7.75 7.86-3.6-3.65a.77.77 0 0 0-1.1 0 .8.8 0 0 0 0 1.12l4.15 4.21a.77.77 0 0 0 1.1 0z" />
            <path fill="currentColor" fill-rule="evenodd" d="M32 16c0 8.84-7.16 16-16 16S0 24.84 0 16 7.16 0 16 0s16 7.16 16 16m-1 0c0 8.28-6.72 15-15 15S1 24.28 1 16 7.72 1 16 1s15 6.72 15 15" clip-rule="evenodd" />
          </svg>
          Use NextSDS to reduce non-compliance dramatically.
        </p>
        <p class="flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 32 32" class="text-white">
            <path fill="currentColor" d="M22.8 12.3c.304-.308.304-.808 0-1.12s-.796-.308-1.1 0l-7.75 7.86-3.6-3.65a.77.77 0 0 0-1.1 0 .8.8 0 0 0 0 1.12l4.15 4.21a.77.77 0 0 0 1.1 0z" />
            <path fill="currentColor" fill-rule="evenodd" d="M32 16c0 8.84-7.16 16-16 16S0 24.84 0 16 7.16 0 16 0s16 7.16 16 16m-1 0c0 8.28-6.72 15-15 15S1 24.28 1 16 7.72 1 16 1s15 6.72 15 15" clip-rule="evenodd" />
          </svg>
          Use NextSDS to reduce non-compliance dramatically.
        </p>
      </div>
    </div>
  
    <p class="text-sm text-center text-gray-400 mt-4">
      According to a study in 1620 companies across 29 countries by the ECHA
    </p>
  </section>
  
  