---

<section class="mb-[80px] mx-2">
  <div
    class="bg-cover bg-center rounded-[15px] py-10 sm:px-0"
    style="background-image: url('/CTA.png')"
  >
    <h3 class="text-white text-2xl md:text-3xl font-semibold text-center mb-6">
      Get organized in minutes.
    </h3>

    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-[31px] mt-[31px]"
    >
      <a
        href="#"
        class="bg-[#04E762] text-[081b60] font-semibold px-6 py-3 rounded-lg shadow flex items-center gap-2"
      >
        <span>Get started for free</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"
          ></path>
        </svg>
      </a>

      <button
        class="bg-white/20 text-white px-6 py-3 rounded-lg font-semibold flex items-center gap-2 shadow"
      >
        Or get a demo from
        <img
          src="/CTA_1.png"
          alt="Fritz"
          class="rounded-full w-6 h-6 object-cover"
        />
      </button>
    </div>

    <p class="text-xs text-white opacity-80 text-center">
      No credit card required, no strings attached.
    </p>
  </div>
</section>
