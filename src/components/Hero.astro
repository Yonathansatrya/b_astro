---

<section class="mb-[80px] mx-2">
    <div
        class="bg-cover bg-center rounded-[15px] sm:py-10"
        style="background-image: url('/hero.png')"
    >
        <div class="relative z-10 text-white px-6 md:px-12 max-w-3xl">
            <h1 class="text-3xl md:text-4xl leading-snug mb-6">
                Increase <span class="font-bold">workplace safety</span> and
                <span class="font-bold">compliance</span> by streamlining your
                <span class="font-semibold"
                    >safety information, powered by AI.</span
                >
            </h1>

            <p class="text-base md:text-lg mb-8 max-w-sm">
                NextSDS is the technology platform that turns complex safety
                data sheets into accessible, standardized information. Meet
                regulatory requirements, save time and resources.
            </p>

            <div class="flex flex-col sm:flex-row items-baseline gap-6 mt-6">
                <div class="items-center inline-flex flex-col">
                    <a
                        href="#"
                        class="inline-flex items-center gap-2 bg-[#325DF7] hover:bg-[#1e47d4] text-white px-6 py-3 rounded-md font-semibold text-base shadow-md transition"
                    >
                        Get started for free
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-5 h-5"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                        >
                            <path
                                d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"
                            ></path>
                        </svg>
                    </a>
                    <p class="text-xs text-gray-400 mt-2">
                        No credit card required
                    </p>
                </div>

                <a
                    href="#"
                    class="text-base font-medium text-white hover:text-gray-300 transition mb-6 sm:mb-0"
                >
                    Get a demo & ask us anything
                </a>
            </div>
        </div>
    </div>
</section>
