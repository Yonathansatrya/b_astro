---

<!-- Feature Utama -->
<section class="mb-[80px] text-center text-[#081b60] mx-2">
    <h2 class="text-2xl md:text-3xl font-semibold mb-12">
        NextSDS AI Supercharged Features
    </h2>

    <div
        class="grid sm:grid-cols-2 lg:grid-cols-2 gap-10 items-start text-left"
    >
        <div class="space-y-4">
            <h3 class="text-2xl font-semibold text-center sm:text-left">
                Clear & Intelligent Management
            </h3>
            <p class="text-sm text-gray-600 text-center sm:text-left">
                Drag-and-dump all your safety data sheets, or add from our
                global database. We automatically extract all the information.
            </p>
            <img
                src="/Feature.svg"
                alt="Feature"
                class="rounded-xl shadow-md w-full"
            />
        </div>

        <div class="space-y-4">
            <h3 class="text-2xl font-semibold text-center sm:text-left">
                Automatic Chemical Inventory
            </h3>
            <p class="text-sm text-gray-600 text-center sm:text-left">
                A comprehensive chemical inventory is automatically generated
                from your library or lists, easy to export to any format.
            </p>
            <img
                src="/Feature.svg"
                alt="Feature"
                class="rounded-xl shadow-md w-full"
            />
        </div>

        <div class="space-y-4">
            <h3 class="text-2xl font-semibold text-center sm:text-left">
                Streamlined risk assessment
            </h3>
            <p class="text-sm text-gray-600 text-center sm:text-left">
                A comprehensive chemical inventory is automatically generated
                from your library or lists, easy to export to any format.
            </p>
            <img
                src="/Feature.svg"
                alt="Feature"
                class="rounded-xl shadow-md w-full"
            />
        </div>

        <div class="space-y-4">
            <h3 class="text-2xl font-semibold text-center sm:text-left">
                Automated SIC Generation & Translation
            </h3>
            <p class="text-sm text-gray-600 text-center sm:text-left">
                Generate human friendly and summarized Safety Information Cards
                automatically, and translate instantly.
            </p>
            <img
                src="/Feature.svg"
                alt="Feature"
                class="rounded-xl shadow-md w-full"
            />
        </div>

        <div class="space-y-4">
            <h3 class="text-2xl font-semibold text-center sm:text-left">
                Personal Protective Equipment displayed
            </h3>
            <p class="text-sm text-gray-600 text-center sm:text-left">
                Instantly see required PPE s per substance, with automatic
                clustering of large sets coming soon!
            </p>
            <img
                src="/Feature.svg"
                alt="Feature"
                class="rounded-xl shadow-md w-full"
            />
        </div>

        <div class="space-y-4">
            <h3 class="text-2xl font-semibold text-center sm:text-left">
                CLP compliance for e commerce
            </h3>
            <p class="text-sm text-gray-600 text-center sm:text-left">
                Automatically display required safety information on every
                product page, simple implementation and automated updating.
            </p>
            <img
                src="/Feature.svg"
                alt="Feature"
                class="rounded-xl shadow-md w-full"
            />
        </div>
    </div>
</section>

<!-- Extra Feature -->
<section class="mb-[80px] text-[#081b60] text-center mx-2">
    <h2 class="text-2xl md:text-3xl text-[#081b60] font-semibold mb-10">
        Powerful, tens to thousands, local to global.
    </h2>
    <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[24px] mx-auto"
    >
        <div class="bg-gray-100 p-6 rounded-lg shadow-sm text-left">
            <div class="flex items-center gap-2 mb-4">
                <img
                    src="/Feature_icon_1.svg"
                    alt="High volume handling"
                    class="w-5 h-5"
                />
                <div class="text-xl font-semibold">High volume handling</div>
            </div>
            <p class="text-sm text-gray-600">
                Process thousands of SDS documents simultaneously with
                intelligent error detection.
            </p>
        </div>

        <div class="bg-gray-100 p-6 rounded-lg shadow-sm text-left">
            <div class="flex items-center gap-2 mb-4">
                <img
                    src="/Feature_icon_2.svg"
                    alt="Another Feature"
                  class="w-5 h-5"
                />
                <div class="text-xl font-semibold">Handles any file format</div>
            </div>
            <p class="text-sm text-gray-600">
                Process SDS documents in various formats including PDF, DOC,
                DOCX, XML or HTML.
            </p>
        </div>

        <div class="bg-gray-100 p-6 rounded-lg shadow-sm text-left">
            <div class="flex items-center gap-2 mb-4">
                <img
                    src="/Feature_icon_3.svg"
                    alt="Third Feature"
                    class="w-5 h-5"
                />
                <div class="text-xl font-semibold">Multi language support</div>
            </div>
            <p class="text-sm text-gray-600">
                AI assisted translation of SDS
                documents and Workplace Safety
                Cards across multiple languages.
            </p>
        </div>

        <div class="bg-gray-100 p-6 rounded-lg shadow-sm text-left">
            <div class="flex items-center gap-2 mb-4">
                <img
                    src="/Feature_icon_4.svg"
                    alt="Third Feature"
                    class="w-5 h-5"
                />
                <div class="text-xl font-semibold">Version control</div>
            </div>
            <p class="text-sm text-gray-600 mb-2">
                Track and manage SDS versions
                effectively. Automatically detect and
                highlight changes between versions.
            </p>
        </div>

        <div class="bg-gray-100 p-6 rounded-lg shadow-sm text-left">
            <div class="flex items-center gap-2 mb-4">
                <img
                    src="/Feature_icon_5.svg"
                    alt="Third Feature"
                    class="w-5 h-5"
                />
                <div class="text-xl font-semibold">Export & Integration</div>
            </div>
            <p class="text-sm text-gray-600 mb-2">
                Export data in JSON and eSDScom
                XML formats for seamless integration
                with ERP and LIMS systems.
            </p>
        </div>

        <div class="bg-gray-100 p-6 rounded-lg shadow-sm text-left">
            <div class="flex items-center gap-2 mb-4">
                <img
                    src="/Feature_icon_6.svg"
                    alt="Third Feature"
                    class="w-5 h-5"
                />
                <div class="text-xl font-semibold">Secure & GDPR Compliant</div>
            </div>
            <p class="text-sm text-gray-600 mb-2">
                Enterprise grade security with
                encrypted data transmission, secure
                storage, access controls.
            </p>
        </div>
    </div>
</section>
