---

<section class="mb-[80px] bg-white mx-2">
    <div class="mx-auto px-6 lg:px-20">
        <h2
            class="text-2xl sm:text-3xl md:px-12 font-semibold text-center text-[#0F1D3F] mb-4 leading-snug"
        >
            Reduce risk of 🥽 workplace accidents, 🦠 health damage, <br
                class="hidden sm:block"
            />
            🍃 environmental violations and ✅ increase compliance.
        </h2>

        <div class="max-w-full mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 text-[#0F1D3F] mt-[59px]">
            <div>
                <p class="text-lg text-gray-800 font-medium text-left mb-[38px]">
                    Our AI platform understands safety data sheets,<br
                        class="hidden md:block"
                    />
                    so you can easily organise & automate your:
                </p>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-10 mx-auto text-[#0F1D3F] text-sm"
                >
                    <div class="space-y-5">
                        <div
                            class="flex justify-between items-center border-b border-gray-300 pb-1"
                        >
                            <span>Digital SDS Library</span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="17"
                                height="17"
                                viewBox="0 0 25 25"
                                fill="currentColor"
                            >
                                <path
                                    d="m8.006 21.308l-1.064-1.064L15.187 12L6.942 3.756l1.064-1.064L17.314 12z"
                                ></path>
                            </svg>
                        </div>
    
                        <div
                            class="flex justify-between items-center border-b border-gray-300 pb-1"
                        >
                            <span>Chemical Inventory</span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="17"
                                height="17"
                                viewBox="0 0 25 25"
                                fill="currentColor"
                            >
                                <path
                                    d="m8.006 21.308l-1.064-1.064L15.187 12L6.942 3.756l1.064-1.064L17.314 12z"
                                ></path>
                            </svg>
                        </div>
    
                        <div
                            class="flex justify-between items-center border-b border-gray-300 pb-1"
                        >
                            <span>Risk Assessment</span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="17"
                                height="17"
                                viewBox="0 0 25 25"
                                fill="currentColor"
                            >
                                <path
                                    d="m8.006 21.308l-1.064-1.064L15.187 12L6.942 3.756l1.064-1.064L17.314 12z"
                                ></path>
                            </svg>
                        </div>
                    </div>
    
                    <div class="space-y-5">
                        <div
                            class="flex justify-between items-center border-b border-gray-300 pb-1"
                        >
                            <span>SIC Generation & Translation</span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="17"
                                height="17"
                                viewBox="0 0 25 25"
                                fill="currentColor"
                            >
                                <path
                                    d="m8.006 21.308l-1.064-1.064L15.187 12L6.942 3.756l1.064-1.064L17.314 12z"
                                ></path>
                            </svg>
                        </div>
    
                        <div
                            class="flex justify-between items-center border-b border-gray-300 pb-1"
                        >
                            <span>Personal Protective Equipment</span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="17"
                                height="17"
                                viewBox="0 0 25 25"
                                fill="currentColor"
                            >
                                <path
                                    d="m8.006 21.308l-1.064-1.064L15.187 12L6.942 3.756l1.064-1.064L17.314 12z"
                                ></path>
                            </svg>
                        </div>
    
                        <div
                            class="flex justify-between items-center border-b border-gray-300 pb-1"
                        >
                            <span>CLP Compliance for e-commerce</span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="17"
                                height="17"
                                viewBox="0 0 25 25"
                                fill="currentColor"
                            >
                                <path
                                    d="m8.006 21.308l-1.064-1.064L15.187 12L6.942 3.756l1.064-1.064L17.314 12z"
                                ></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
            <div class="w-full flex">
                <img src="how.png" alt="How It Works" class="max-w-full h-auto">
              </div>
        </div>
    </div>
</section>
